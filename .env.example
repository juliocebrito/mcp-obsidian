OBSIDIAN_URL=https://127.0.0.1:27124
OBSIDIAN_TOKEN=replace-with-your-obsidian-token

# Verificación TLS contra Obsidian. Desactivada por defecto: su certificado es autofirmado.
OBSIDIAN_VERIFY_TLS=0

# --- Servidor MCP (src/mcp_obsidian) ---
MCP_PORT=8001

# Publica solo search_notes, get_note y list_directory. Tiene prioridad sobre el flag siguiente.
MCP_READ_ONLY=0

# Publica move_note y delete_note, y deja que create_note sobrescriba notas existentes.
# Desactivadas por defecto: el modelo decide solo cuándo invocarlas.
MCP_ALLOW_DESTRUCTIVE=0

# Token que protege el endpoint HTTP. Sin él, /mcp queda abierto: obligatorio detrás de ngrok.
# Genéralo con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Credenciales del cliente OAuth, para clientes que no admiten pegar un Bearer (Gemini).
# Si están vacías se usa solo MCP_AUTH_TOKEN y no se monta el authorization server.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Allowlist de redirect_uri del cliente, separada por comas. Vacía acepta cualquiera:
# míralo en el aviso del primer /authorize y fíjalo aquí.
MCP_OAUTH_REDIRECT_URIS=

# URL pública del endpoint (la de ngrok, no localhost: viaja en la cabecera WWW-Authenticate
# y el cliente remoto tiene que poder resolverla) y del authorization server que lo respalda.
MCP_RESOURCE_URL=https://tu-tunel.ngrok-free.dev/mcp
MCP_ISSUER_URL=https://tu-tunel.ngrok-free.dev

# Allowlist de la cabecera Host, separada por comas y SIN esquema. Sin ella todo responde 421.
MCP_ALLOWED_HOSTS=tu-tunel.ngrok-free.dev
# Los Origin sí llevan esquema.
MCP_ALLOWED_ORIGINS=https://tu-tunel.ngrok-free.dev